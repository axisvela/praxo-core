{
  "name": "@axisvela/praxo-core",
  "version": "0.1.4",
  "description": "Dependency-free TypeScript agent framework: tools, policy, memory, middleware, checkpoints, streaming.",
  "license": "MIT",
  "keywords": [
    "agents",
    "agent-framework",
    "llm",
    "tool-calling",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axisvela/praxo-core.git",
    "directory": "language/typescript"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "api": "node api-snapshot.js && node api-signatures.js",
    "api:check": "node api-snapshot.js --check && node api-signatures.js --check",
    "conformance": "node dist/conformance/run.js",
    "test": "npm run build && npm run conformance && node --test tests/sdk.test.js tests/openaicompat.test.js tests/api-signatures.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
