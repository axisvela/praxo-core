{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "axisvela/praxo-laravel-ai-editorial-studio",
    "description": "Laravel-native AI editorial studio reference application for PRAXO-CORE",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "axisvela/praxo-core": "0.8.1",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
