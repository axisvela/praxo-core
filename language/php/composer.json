{
  "name": "axisvela/praxo-core",
  "description": "PRAXO-CORE (praxocore): an embeddable MIT-licensed native PHP AI agent framework with tool calling, policy, events, memory, checkpoints, middleware, and process plugins; usable in Laravel hosts, not an HTTP user agent or hosted service",
  "keywords": [
    "praxocore",
    "praxo-core",
    "php",
    "ai",
    "ai-agents",
    "agent-framework",
    "llm",
    "tool-calling",
    "policy",
    "human-in-the-loop",
    "memory",
    "checkpoints",
    "middleware",
    "process-plugins",
    "openai-compatible",
    "anthropic",
    "gemini",
    "mcp",
    "opentelemetry",
    "laravel"
  ],
  "type": "library",
  "license": "MIT",
  "version": "0.10.2",
  "require": {
    "php": ">=8.2"
  },
  "autoload": {
    "psr-4": {
      "Praxo\\Core\\": "src/"
    },
    "files": [
      "src/autoload.php"
    ]
  },
  "scripts": {
    "conformance": "php conformance/run.php",
    "test": "php tests/run.php"
  },
  "config": {
    "sort-packages": true
  }
}
