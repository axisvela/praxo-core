{
  "name": "axisvela/praxo-core",
  "description": "PHP SDK for the PRAXO-CORE agent contract",
  "type": "library",
  "license": "MIT",
  "version": "0.5.0",
  "require": {
    "php": ">=8.2"
  },
  "autoload": {
    "psr-4": {
      "Praxo\\Core\\": "src/"
    },
    "files": [
      "src/autoload.php"
    ]
  },
  "scripts": {
    "conformance": "php conformance/run.php",
    "test": "php tests/run.php"
  },
  "config": {
    "sort-packages": true
  }
}
