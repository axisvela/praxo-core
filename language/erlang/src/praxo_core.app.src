{application, praxo_core,
 [{description, "Embeddable MIT-licensed agent framework for Erlang"},
  {pkg_name, "praxo_core_erlang"},
  {vsn, "0.1.1"},
  {registered, []},
  {applications, [kernel, stdlib]},
  {env, []},
  {licenses, ["MIT"]},
  {links, [{"GitHub", "https://github.com/axisvela/praxo-core"}]},
  {modules, [praxo_agent,
             praxo_checkpoint,
             praxo_json,
             praxo_jsonschema,
             praxo_memory,
             praxo_middleware,
             praxo_models,
             praxo_plugin,
             praxo_runtime,
             praxo_sink,
             praxo_toolcall,
             praxo_util]}]}.
