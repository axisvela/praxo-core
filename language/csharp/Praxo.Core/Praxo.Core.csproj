<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Praxo.Core</RootNamespace>
    <AssemblyName>Praxo.Core</AssemblyName>
    <PackageId>Praxo.Core</PackageId>
    <Version>0.11.1</Version>
    <Authors>AxisVela</Authors>
    <Description>PRAXO-CORE (praxocore): embeddable MIT-licensed AI agent framework for C# and .NET with tool calling, policy hooks, human-in-the-loop approvals, checkpoints, streaming, and events</Description>
    <PackageTags>praxo-core;praxocore;csharp;dotnet;ai-agents;llm;agent-framework;tool-calling;tool-authorization;human-in-the-loop;checkpoints;streaming;mcp;opentelemetry;embeddable</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://axisvela.github.io/praxo-core/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/axisvela/praxo-core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <None Include="../REGISTRY.md" Pack="true" PackagePath="\" />
    <None Include="../llms.txt" Pack="true" PackagePath="\" />
    <None Include="../llms.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
