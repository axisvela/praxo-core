{
  "specVersion": "0.1.0",
  "kind": "events",
  "source": "pkg/event and docs/event-schema.md",
  "event": {
    "fields": [
      { "name": "type", "type": "string", "required": true },
      { "name": "sessionId", "type": "string", "required": true },
      { "name": "runId", "type": "string", "required": false, "omitempty": true },
      { "name": "data", "type": "object", "required": false, "omitempty": true },
      { "name": "at", "type": "string", "format": "date-time", "required": true }
    ],
    "notes": [
      "at is set to UTC when the emitter leaves it zero.",
      "event.Sink has no retry, delivery, or durability guarantee.",
      "MultiSink is fail-fast, not best-effort."
    ]
  },
  "eventTypes": [
    { "type": "run.started", "dataKeys": [], "when": "A run enters the governed loop" },
    { "type": "run.completed", "dataKeys": [], "when": "A run returns successfully" },
    { "type": "run.failed", "dataKeys": ["error"], "when": "A run returns an error, including policy or approval denial" },
    { "type": "tool.call", "dataKeys": ["name", "arguments"], "when": "A tool call is about to execute" },
    { "type": "tool.interrupt", "dataKeys": ["name", "arguments"], "when": "A tool call is waiting for an approval decision" }
  ],
  "streamKinds": [
    { "kind": "values", "meaning": "run-level state snapshot" },
    { "kind": "updates", "meaning": "incremental state changes" },
    { "kind": "messages", "meaning": "model messages" },
    { "kind": "tasks", "meaning": "tool-task lifecycle changes" },
    { "kind": "debug", "meaning": "internal diagnostics" },
    { "kind": "checkpoint", "meaning": "durable run checkpoint" }
  ],
  "streamPart": {
    "wire": false,
    "fields": ["RunID", "SessionID", "Kind", "Step", "Data", "At"],
    "notes": [
      "pkg/agent/stream.StreamPart has no JSON tags.",
      "Only the kind values are frozen for cross-language parity.",
      "A JSON projection of StreamPart requires a future spec change."
    ]
  }
}
