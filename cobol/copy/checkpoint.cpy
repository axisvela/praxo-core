       01 px-checkpoint-request.
          05 px-ck-op pic x(16).
          05 px-ck-type pic x(128).
          05 px-ck-type-length binary-long.
          05 px-ck-value pic x(32768).
          05 px-ck-value-length binary-long.
       01 px-checkpoint-result.
          05 px-ck-output pic x(32768).
          05 px-ck-output-length binary-long.
          05 px-ck-error pic x(64).
